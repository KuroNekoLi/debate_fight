# LLM provider: mock | openai | gemini
DEBATE_LLM_PROVIDER=openai

# Model name
DEBATE_MODEL=gpt-4o-mini

# Optional API keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=

# Runtime settings
DEBATE_TEMPERATURE=0.4
DEBATE_MAX_TOKENS=1200
DEBATE_MAX_WORKERS=1
DEBATE_SEED=42

# Paths
DEBATE_ARGUMENTS_PATH=data/arguments.json
DEBATE_RESULTS_DIR=results
